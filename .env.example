# Build setting, public URL, not a secret. Default uses the same host.
CONTACT_ENDPOINT=/api/contact
# Server secrets only: configure separately for Cloudflare Pages Preview.
TELEGRAM_BOT_TOKEN=
CONTACT_CHAT_VIETNAM=
CONTACT_CHAT_DAHAB=
CONTACT_CHAT_RUSSIA=
CONTACT_HASH_SECRET=
# Optional exact origins when API is on a different host. No wildcard.
CONTACT_ALLOWED_ORIGINS=
# Bind a D1 database as CONTACT_DB; apply server/contact-schema.sql.
# Use a separate test Telegram channel for staging; no production chats.
